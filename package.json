{
  "name": "echoo-module-example",
  "private": true,
  "version": "0.0.0-dev",
  "description": "Echoo 示例模块仓库",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "sdk:verify": "node .echoo/sdk/current/tools/sdk.mjs verify",
    "sdk:check": "pnpm -r --if-present run sdk:check",
    "sdk:capture": "pnpm -r --if-present run sdk:capture"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.19.2",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "yaml": "2.8.4",
    "tsup": "8.5.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "tsup@8.5.1": ".echoo/sdk/current/tools/patches/tsup@8.5.1.patch"
    }
  }
}
