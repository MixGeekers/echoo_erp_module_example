# Normalize text files to LF in every working tree.
* text=auto eol=lf

# 翻译 CSV 保持导出时的 UTF-8 BOM 与 CRLF，便于 Excel 直接打开。
*.csv -text

# Windows command scripts need CRLF for compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf


# Binary assets.
